diff --git a/agent/transform_output.py b/agent/transform_output.py
new file mode 100644
index 0000000000..5172629228
--- /dev/null
+++ b/agent/transform_output.py
@@ -0,0 +1,188 @@
+"""Structured ``transform_llm_output`` handling for turn finalization.
+
+The upstream hook accepts strings only and runs after session persistence.  A
+structured transform (for example refusal-recovery) also returns provider/model
+usage that must be folded into the host session.  This module keeps that local
+compatibility seam out of the already-large turn finalizer.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Optional
+
+
+def _token(usage: dict, name: str) -> int:
+    try:
+        return max(0, int(usage.get(name, 0) or 0))
+    except (TypeError, ValueError):
+        return 0
+
+
+def record_transform_usage(agent: Any, payload: Any, logger: Any) -> Optional[dict]:
+    """Fold structured transform-hook usage into in-memory and DB accounting."""
+    usage = payload.get("usage") if isinstance(payload, dict) else None
+    if not isinstance(usage, dict):
+        return None
+
+    input_tokens = _token(usage, "input_tokens")
+    output_tokens = _token(usage, "output_tokens")
+    cache_read_tokens = _token(usage, "cache_read_tokens")
+    cache_write_tokens = _token(usage, "cache_write_tokens")
+    total_tokens = _token(usage, "total_tokens") or input_tokens + output_tokens
+    if not any((
+        input_tokens,
+        output_tokens,
+        total_tokens,
+        cache_read_tokens,
+        cache_write_tokens,
+    )):
+        return None
+
+    for attr, delta in (
+        ("session_prompt_tokens", input_tokens),
+        ("session_completion_tokens", output_tokens),
+        ("session_total_tokens", total_tokens),
+        ("session_input_tokens", input_tokens),
+        ("session_output_tokens", output_tokens),
+        ("session_cache_read_tokens", cache_read_tokens),
+        ("session_cache_write_tokens", cache_write_tokens),
+        ("session_api_calls", 1),
+    ):
+        setattr(agent, attr, int(getattr(agent, attr, 0) or 0) + delta)
+
+    provider = str(payload.get("provider") or getattr(agent, "provider", "") or "")
+    model = str(payload.get("model") or getattr(agent, "model", "") or "")
+    base_url = str(payload.get("base_url") or getattr(agent, "base_url", "") or "")
+    cost_amount = usage.get("cost_usd")
+    cost_status = "unknown"
+    cost_source = "plugin_llm"
+    try:
+        if cost_amount is None:
+            from agent.usage_pricing import CanonicalUsage, estimate_usage_cost
+
+            cost_result = estimate_usage_cost(
+                model,
+                CanonicalUsage(
+                    input_tokens=input_tokens,
+                    output_tokens=output_tokens,
+                    cache_read_tokens=cache_read_tokens,
+                    cache_write_tokens=cache_write_tokens,
+                ),
+                provider=provider,
+                base_url=base_url,
+            )
+            cost_amount = cost_result.amount_usd
+            cost_status = cost_result.status
+            cost_source = cost_result.source
+        else:
+            cost_amount = max(0.0, float(cost_amount))
+            cost_status = "estimated"
+    except (TypeError, ValueError):
+        cost_amount = None
+
+    if cost_amount is not None:
+        agent.session_estimated_cost_usd = float(
+            getattr(agent, "session_estimated_cost_usd", 0.0) or 0.0
+        ) + float(cost_amount)
+    if cost_status != "unknown":
+        agent.session_cost_status = cost_status
+        agent.session_cost_source = cost_source
+
+    session_db = getattr(agent, "_session_db", None)
+    session_id = str(getattr(agent, "session_id", "") or "")
+    if session_db is not None and session_id:
+        try:
+            if not getattr(agent, "_session_db_created", False):
+                ensure = getattr(agent, "_ensure_db_session", None)
+                if callable(ensure):
+                    ensure()
+            session_db.update_token_counts(
+                session_id,
+                input_tokens=input_tokens,
+                output_tokens=output_tokens,
+                cache_read_tokens=cache_read_tokens,
+                cache_write_tokens=cache_write_tokens,
+                reasoning_tokens=0,
+                estimated_cost_usd=cost_amount,
+                cost_status=cost_status,
+                cost_source=cost_source,
+                billing_provider=provider,
+                billing_base_url=base_url,
+                billing_mode="subscription_included"
+                if cost_status == "included"
+                else None,
+                model=model,
+                api_call_count=1,
+            )
+        except Exception as exc:
+            logger.debug(
+                "Transform-hook token persistence failed (session=%s): %s",
+                session_id,
+                exc,
+            )
+
+    return {
+        "input_tokens": input_tokens,
+        "output_tokens": output_tokens,
+        "total_tokens": total_tokens,
+        "cache_read_tokens": cache_read_tokens,
+        "cache_write_tokens": cache_write_tokens,
+        "cost_usd": cost_amount,
+        "provider": provider,
+        "model": model,
+    }
+
+
+def apply_transform_hook(
+    agent: Any,
+    *,
+    final_response: str,
+    messages: list,
+    effective_task_id: str,
+    turn_id: str,
+    original_user_message: Any,
+    logger: Any,
+) -> tuple[str, bool, Optional[dict]]:
+    """Run the first non-empty transform and accept string or structured output."""
+    from hermes_cli.lifecycle import invoke_hook
+
+    results = invoke_hook(
+        "transform_llm_output",
+        response_text=final_response,
+        session_id=getattr(agent, "session_id", "") or "",
+        task_id=effective_task_id,
+        turn_id=turn_id,
+        user_message=original_user_message,
+        conversation_history=[
+            dict(message) if isinstance(message, dict) else message
+            for message in messages
+        ],
+        model=getattr(agent, "model", ""),
+        provider=getattr(agent, "provider", ""),
+        base_url=getattr(agent, "base_url", ""),
+        platform=getattr(agent, "platform", None) or "",
+    )
+    for hook_result in results:
+        transformed_text = None
+        if isinstance(hook_result, str):
+            transformed_text = hook_result
+        elif isinstance(hook_result, dict):
+            transformed_text = hook_result.get("text")
+        if isinstance(transformed_text, str) and transformed_text:
+            transform_usage = record_transform_usage(agent, hook_result, logger)
+            return transformed_text, True, transform_usage
+    return final_response, False, None
+
+
+def sync_final_assistant_content(agent: Any, messages: list, content: str) -> None:
+    """Align the durable tail row with the exact response that will be delivered."""
+    if (
+        messages
+        and isinstance(messages[-1], dict)
+        and messages[-1].get("role") == "assistant"
+    ):
+        messages[-1]["content"] = content
+        messages[-1].pop("_db_persisted", None)
+        agent._db_flush_scan_prefix = None
+        return
+    messages.append({"role": "assistant", "content": content})
