+from types import SimpleNamespace
+from typing import Any
+
+import hermes_cli.lifecycle as lifecycle
+
+from agent.transform_output import sync_final_assistant_content
+from agent.turn_finalizer import finalize_turn
+
+
+class _SessionDb:
+    def __init__(self):
+        self.token_updates = []
+
+    def update_token_counts(self, session_id, **kwargs):
+        self.token_updates.append((session_id, kwargs))
+
+
+class _Agent:
+    def __init__(self, events):
+        self.events = events
+        self.max_iterations = 8
+        self.iteration_budget = SimpleNamespace(remaining=7, used=1, max_total=8)
+        self.quiet_mode = True
+        self.model = "gpt-5.6-sol"
+        self.provider = "openai-codex"
+        self.base_url = "https://example.invalid/v1"
+        self.session_id = "session-1"
+        self.platform = "test"
+        self.context_compressor = SimpleNamespace(
+            last_prompt_tokens=0,
+            _micro_compact_enabled=False,
+        )
+        self.session_input_tokens = 0
+        self.session_output_tokens = 0
+        self.session_cache_read_tokens = 0
+        self.session_cache_write_tokens = 0
+        self.session_reasoning_tokens = 0
+        self.session_prompt_tokens = 0
+        self.session_completion_tokens = 0
+        self.session_total_tokens = 0
+        self.session_api_calls = 0
+        self.session_estimated_cost_usd = 0.0
+        self.session_cost_status = "unknown"
+        self.session_cost_source = "none"
+        self._session_db = _SessionDb()
+        self._session_db_created = True
+        self._tool_guardrail_halt_decision = None
+        self._interrupt_message = None
+        self._response_was_previewed = False
+        self._skill_nudge_interval = 0
+        self._iters_since_skill = 0
+        self.valid_tool_names = set()
+        self._turn_failed_file_mutations = {}
+        self._db_flush_scan_prefix = ["old-snapshot"]
+        self.request_overrides = {}
+        self.persisted_messages = None
+        self.persist_calls = 0
+
+    def _save_trajectory(self, *_args, **_kwargs):
+        self.events.append("trajectory")
+
+    def _cleanup_task_resources(self, *_args, **_kwargs):
+        self.events.append("cleanup")
+
+    def _drop_trailing_empty_response_scaffolding(self, _messages):
+        pass
+
+    def _apply_persist_user_message_override(self, _messages):
+        pass
+
+    def _persist_session(self, messages, _history):
+        self.events.append("persist")
+        self.persist_calls += 1
+        self.persisted_messages = [dict(message) for message in messages]
+
+    def _file_mutation_verifier_enabled(self):
+        return False
+
+    def _turn_completion_explainer_enabled(self):
+        return False
+
+    def _drain_pending_steer(self):
+        return None
+
+    def clear_interrupt(self):
+        pass
+
+    def _sync_external_memory_for_turn(self, **_kwargs):
+        pass
+
+
+def _finalize(agent: _Agent):
+    messages = [
+        {"role": "user", "content": "question"},
+        {
+            "role": "assistant",
+            "content": "original refusal",
+            "_db_persisted": True,
+        },
+    ]
+    return finalize_turn(
+        agent,
+        final_response="original refusal",
+        api_call_count=1,
+        interrupted=False,
+        failed=False,
+        messages=messages,
+        conversation_history=[],
+        effective_task_id="task-1",
+        turn_id="turn-1",
+        user_message="question",
+        original_user_message="question",
+        _should_review_memory=False,
+        _turn_exit_reason="text_response(stop)",
+    )
+
+
+def test_structured_transform_is_persisted_once_and_accounted(monkeypatch):
+    events = []
+    transform_kwargs: dict[str, Any] = {}
+
+    def invoke_hook(name, **kwargs):
+        if name == "transform_llm_output":
+            events.append("transform")
+            transform_kwargs.update(kwargs)
+            return [
+                {
+                    "text": "recovered answer",
+                    "provider": "openai-codex",
+                    "model": "gpt-5.6-sol",
+                    "usage": {
+                        "input_tokens": 120,
+                        "output_tokens": 30,
+                        "total_tokens": 150,
+                        "cache_read_tokens": 20,
+                        "cache_write_tokens": 0,
+                        "cost_usd": 0.001,
+                    },
+                }
+            ]
+        return []
+
+    monkeypatch.setattr(lifecycle, "invoke_hook", invoke_hook)
+    agent = _Agent(events)
+
+    result = _finalize(agent)
+
+    assert events.index("transform") < events.index("persist")
+    assert agent.persist_calls == 1
+    persisted = agent.persisted_messages
+    assert persisted is not None
+    assert persisted[-1]["content"] == "recovered answer"
+    assert "_db_persisted" not in persisted[-1]
+    assert result["final_response"] == "recovered answer"
+    assert result["messages"][-1]["content"] == "recovered answer"
+    assert result["response_transformed"] is True
+    assert result["transform_usage"]["total_tokens"] == 150
+    assert agent.session_input_tokens == 120
+    assert agent.session_output_tokens == 30
+    assert agent.session_total_tokens == 150
+    assert agent.session_api_calls == 1
+    assert agent.session_estimated_cost_usd == 0.001
+    assert agent.session_cost_status == "estimated"
+    assert agent.session_cost_source == "plugin_llm"
+    assert len(agent._session_db.token_updates) == 1
+    session_id, token_delta = agent._session_db.token_updates[0]
+    assert session_id == "session-1"
+    assert token_delta["input_tokens"] == 120
+    assert token_delta["output_tokens"] == 30
+    assert token_delta["api_call_count"] == 1
+    assert transform_kwargs["user_message"] == "question"
+    assert transform_kwargs["conversation_history"][-1]["content"] == "original refusal"
+    assert transform_kwargs["provider"] == "openai-codex"
+    assert transform_kwargs["base_url"] == "https://example.invalid/v1"
+
+
+def test_legacy_string_transform_is_still_persisted(monkeypatch):
+    monkeypatch.setattr(
+        lifecycle,
+        "invoke_hook",
+        lambda name, **_kwargs: (
+            ["legacy replacement"] if name == "transform_llm_output" else []
+        ),
+    )
+    agent = _Agent([])
+
+    result = _finalize(agent)
+
+    assert result["final_response"] == "legacy replacement"
+    assert result["response_transformed"] is True
+    assert result["transform_usage"] is None
+    assert agent.persist_calls == 1
+    persisted = agent.persisted_messages
+    assert persisted is not None
+    assert persisted[-1]["content"] == "legacy replacement"
+
+
+def test_hook_failure_still_invalidates_and_persists_assistant_tail(monkeypatch):
+    def invoke_hook(name, **_kwargs):
+        if name == "transform_llm_output":
+            raise RuntimeError("plugin exploded")
+        return []
+
+    monkeypatch.setattr(lifecycle, "invoke_hook", invoke_hook)
+    agent = _Agent([])
+
+    result = _finalize(agent)
+
+    persisted = agent.persisted_messages
+    assert persisted is not None
+    assert agent.persist_calls == 1
+    assert result["final_response"] == "original refusal"
+    assert result["response_transformed"] is False
+    assert persisted[-1]["content"] == "original refusal"
+    assert "_db_persisted" not in persisted[-1]
+    assert agent._db_flush_scan_prefix is None
+
+
+def test_sync_final_content_preserves_tool_calls_and_invalidates_cursor():
+    agent = SimpleNamespace(_db_flush_scan_prefix=["snapshot"])
+    messages = [
+        {
+            "role": "assistant",
+            "content": "original",
+            "tool_calls": [{"id": "call-1", "type": "function"}],
+            "_db_persisted": True,
+        }
+    ]
+
+    sync_final_assistant_content(agent, messages, "replacement")
+
+    assert messages == [
+        {
+            "role": "assistant",
+            "content": "replacement",
+            "tool_calls": [{"id": "call-1", "type": "function"}],
+        }
+    ]
+    assert agent._db_flush_scan_prefix is None
