{
  "name": "@arms/rum-electron",
  "version": "0.0.3",
  "description": "ARMS RUM SDK for Electron (monitoring layer; implementation pending)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./preload": "./dist/preload.cjs",
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.mjs"
      },
      "require": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "author": "guangli.fj <guangli.fj@alibaba-inc.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "electron": ">=28.0.0",
    "@trpc/server": "*"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    }
  },
  "dependencies": {
    "@arms/rum-browser": "0.1.8",
    "@arms/rum-core": "0.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rollup": "^4.28.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "examples/electron-react",
    "examples/electron-base"
  ]
}