{
  "name": "rrweb-snapshot",
  "version": "2.0.0",
  "description": "rrweb's component to take a snapshot of DOM, aka DOM serializer",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrweb-io/rrweb.git"
  },
  "main": "./dist/rrweb-snapshot.umd.cjs",
  "module": "./dist/rrweb-snapshot.js",
  "unpkg": "./dist/rrweb-snapshot.umd.cjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/rrweb-snapshot.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/rrweb-snapshot.umd.cjs"
      }
    }
  },
  "files": [
    "umd",
    "dist",
    "package.json"
  ],
  "sideEffects": false,
  "author": "yanzhen@smartx.com",
  "license": "MIT",
  "homepage": "https://github.com/rrweb-io/rrweb/tree/master/packages/rrweb-snapshot#readme",
  "devDependencies": {
    "@rrweb/types": "^2.0.0",
    "@rrweb/utils": "^2.0.0",
    "@types/jsdom": "^20.0.0",
    "@types/node": "^18.15.11",
    "@types/puppeteer": "^5.4.4",
    "puppeteer": "^17.1.3",
    "ts-node": "^7.0.1",
    "tslib": "^1.9.3",
    "typescript": "^5.4.5",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "postcss": "^8.4.38"
  }
}