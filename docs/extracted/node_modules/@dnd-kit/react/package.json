  "types": "./index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "index.js",
    "index.d.ts",
    "index.cjs",
    "hooks.js",
    "hooks.d.ts",
    "hooks.cjs",
    "sortable.js",
    "sortable.d.ts",
    "sortable.cjs",
    "utilities.js",
    "utilities.d.ts",
    "utilities.cjs"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
